{
  "name": "hyunsung-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "serve": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "node scripts/test-language-switcher.cjs && node scripts/test-content.mjs && node scripts/test-translation-source.mjs && node scripts/verify-migration.mjs",
    "check": "npm run build && npm test",
    "test:browser": "node --experimental-strip-types scripts/test-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "5.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-footnote": "4.0.0",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
