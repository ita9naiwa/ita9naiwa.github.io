#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/translate-post [--yes] _posts/YYYY/post.md

If no path is given, the command uses the only changed file under _posts/.
The post is sent to OpenAI Codex only after confirmation. The Korean source is
protected, translations are never committed automatically, and the final diff
is shown for review.
EOF
}

assume_yes=false
post_path=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes) assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "Unknown option: $1"; usage; exit 2 ;;
    *)
      if [[ -n "$post_path" ]]; then
        echo "Only one post can be translated at a time."
        exit 2
      fi
      post_path="$1"
      ;;
  esac
  shift
done

if [[ -z "$post_path" ]]; then
  changed_posts="$(git diff --name-only --diff-filter=ACMR -- _posts)"
  changed_count="$(printf '%s\n' "$changed_posts" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [[ "$changed_count" != "1" ]]; then
    echo "Expected exactly one changed post, found $changed_count."
    usage
    exit 2
  fi
  post_path="$changed_posts"
fi

if [[ "$post_path" = /* ]]; then
  case "$post_path" in
    "$repo_root"/*) post_path="${post_path#"$repo_root"/}" ;;
    *) echo "Post must be inside this repository."; exit 2 ;;
  esac
fi

case "$post_path" in
  _posts/*.md|_posts/*.markdown) ;;
  *) echo "Only Markdown files under _posts/ can be translated."; exit 2 ;;
esac

if [[ ! -f "$post_path" ]]; then
  echo "Post not found: $post_path"
  exit 2
fi

if command -v codex >/dev/null 2>&1; then
  codex_command="$(command -v codex)"
elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
  codex_command="/Applications/ChatGPT.app/Contents/Resources/codex"
else
  echo "Codex CLI was not found on PATH or inside ChatGPT.app."
  exit 2
fi

if [[ "$assume_yes" != true ]]; then
  echo "This will send the complete contents of $post_path to OpenAI Codex."
  printf 'Continue? [y/N] '
  read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "Cancelled."; exit 0 ;;
  esac
fi

translation_tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/blog-translation.XXXXXX")"
trap 'rm -rf "$translation_tmp_dir"' EXIT
cp "$post_path" "$translation_tmp_dir/post.md"

source_info="$(node "$repo_root/scripts/translation-source.mjs" inspect "$translation_tmp_dir/post.md")"
source_language="$(printf '%s\n' "$source_info" | sed -n '1p')"
source_hash_before="$(printf '%s\n' "$source_info" | sed -n '2p')"

for target_language in ja zh en; do
  "$codex_command" exec \
    --ephemeral \
    --sandbox workspace-write \
    --skip-git-repo-check \
    -c 'model_reasoning_effort="low"' \
    -C "$translation_tmp_dir" \
    "Edit only post.md. The immutable source language is $source_language and the only target for this run is $target_language. If needed, wrap the complete source body unchanged in its source-language section. Translate the complete source section faithfully into $target_language and add or replace exactly one matching target section; preserve every other existing section byte-for-byte. Add or update only the $target_language entry in the titles map, keep the top-level title in the source language, set languages: [ko, ja, zh, en] and default_lang: $source_language. Do not rewrite, censor, soften, fact-check, summarize, add examples, change gender/nationality/region, or alter self-disclosure. Preserve every paragraph, heading, blockquote, image, link URL, inline code, repetition, and casual or blunt nuance. The target opening tag must be exactly <section class=\"post-translation\" data-lang=\"$target_language\" markdown=\"1\"> and the source opening tag must contain data-default-language before markdown=\"1\". Keep <!--more--> only in the source section. Do not edit the source text or create other files."
done

node "$repo_root/scripts/translation-source.mjs" validate \
  "$source_language" "$source_hash_before" "$translation_tmp_dir/post.md"

cp "$translation_tmp_dir/post.md" "$post_path"

echo
echo "Translation updated. Nothing was committed. Review this diff:"
git --no-pager diff -- "$post_path"
