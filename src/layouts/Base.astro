---
import '../styles/global.css';
import '@fontsource-variable/google-sans-code';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; date?: string; language?: string; canonicalPath?: string }
const { title, description = 'Notes on machine learning, systems, and life by Hyunsung Lee.', date, language = 'en', canonicalPath } = Astro.props;
const siteTitle = "Hyunsung Lee's Blog";
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': date ? 'BlogPosting' : 'WebSite',
  headline: title || siteTitle,
  url: canonical.href,
  description,
  ...(date ? { datePublished: date } : {}),
  author: { '@type': 'Person', name: 'Hyunsung Lee' },
};
---
<!doctype html>
<html lang={language} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fdfdfd" />
    <meta name="author" content="Hyunsung Lee" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>
      (() => {
        let stored;
        try { stored = localStorage.getItem('theme'); } catch {}
        const theme = stored === 'light' || stored === 'dark' ? stored : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title || siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={date ? 'article' : 'website'} />
    {date && <meta property="article:published_time" content={date} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col">
    <Header />
    <main id="main" class="app-layout flex-1 pt-8 pb-12" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/theme'; import '../scripts/site-language';</script>
  </body>
</html>
