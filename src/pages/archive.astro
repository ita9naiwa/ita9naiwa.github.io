---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/content';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(post => post.tags))].sort();
---
<Base title="All Posts">
  <header class="home-heading mb-8 flex flex-wrap items-baseline justify-between gap-3"><h1 class="text-2xl font-semibold tracking-wide" data-i18n="allPosts">All Posts</h1><span id="post-count" data-i18n="postCount" data-i18n-args={JSON.stringify({ count: posts.length })} class="text-sm text-muted-foreground" aria-live="polite">{posts.length} posts</span></header>
  <div class="archive-controls mb-8"><label class="mb-2 block text-sm" for="post-search" data-i18n="searchPosts">Search posts</label><input class="mb-5 w-full rounded border border-border bg-background px-3 py-2.5 text-foreground placeholder:text-muted-foreground" id="post-search" type="search" placeholder="Title or tag…" data-i18n-placeholder="searchPlaceholder" /><div id="tags" class="tags flex flex-wrap gap-x-5 gap-y-3 text-sm"><a class="underline decoration-dashed underline-offset-4 hover:text-accent aria-[current=true]:text-accent" href="/archive.html" data-tag="" data-i18n="all">All</a>{tags.map(tag => <a class="underline decoration-dashed underline-offset-4 hover:text-accent aria-[current=true]:text-accent" href={`/archive.html?tag=${encodeURIComponent(tag)}`} data-tag={tag}>{tag}</a>)}</div></div>
  <p class="my-10 text-muted-foreground" id="empty-results" data-i18n="noResults" hidden>No posts found.</p>
  <ul class="archive-list">{posts.map(post => <li class="my-6 flex flex-col gap-1 sm:flex-row sm:gap-6" data-tags={JSON.stringify(post.tags)} data-title={post.title.toLowerCase()} data-titles={JSON.stringify(post.titles)}><time class="shrink-0 text-sm text-muted-foreground sm:pt-0.5" datetime={post.date} data-localized-date={post.date}>{post.date.slice(0, 10)}</time><a class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline" href={post.url} data-localized-text={JSON.stringify(post.titles)} data-default-text={post.title}>{post.title}</a></li>)}</ul>
</Base>
<script>
  const search = document.querySelector<HTMLInputElement>('#post-search')!;
  const rows = [...document.querySelectorAll<HTMLElement>('.archive-list li')];
  function filterPosts() {
    const tag = new URLSearchParams(location.search).get('tag') || '';
    const query = search.value.trim().toLowerCase();
    let count = 0;
    rows.forEach(row => {
      const tags: string[] = JSON.parse(row.dataset.tags!);
      const titles = Object.values(JSON.parse(row.dataset.titles || '{}'));
      const searchable = [row.querySelector('a')?.textContent, row.dataset.title, ...titles, ...tags].join(' ').toLowerCase();
      row.hidden = (!!tag && !tags.includes(tag)) || !searchable.includes(query);
      if (!row.hidden) count++;
    });
    const counter = document.querySelector<HTMLElement>('#post-count')!;
    counter.dataset.i18nArgs = JSON.stringify({ count });
    counter.textContent = `${count} posts`;
    document.dispatchEvent(new CustomEvent('blog:uiupdate'));
    document.querySelector<HTMLElement>('#empty-results')!.hidden = count > 0;
    document.querySelectorAll<HTMLAnchorElement>('[data-tag]').forEach(link => {
      if (link.dataset.tag === tag) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }
  search.addEventListener('input', filterPosts);
  document.querySelectorAll<HTMLAnchorElement>('[data-tag]').forEach(link => link.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault(); history.pushState(null, '', link.href); filterPosts();
  }));
  window.addEventListener('popstate', filterPosts);
  document.addEventListener('blog:languagechange', filterPosts);
  filterPosts();
</script>
